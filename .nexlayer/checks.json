{
  "schema": "nexlayer.plan.checks/2",
  "app": "cue-ai",
  "checks": [
    {
      "service": "app",
      "type": "http",
      "expect": "healthy in nexlayer_check_deployment_status, and the deployment URL answers 2xx or 3xx",
      "verify_with": [
        "nexlayer_check_deployment_status",
        "an HTTP request to the deployment URL"
      ],
      "basis": {
        "kind": "read",
        "sources": [
          "nexlayer.yaml"
        ]
      }
    },
    {
      "service": "postgres",
      "type": "running",
      "expect": "healthy in nexlayer_check_deployment_status and stays that way",
      "verify_with": [
        "nexlayer_check_deployment_status"
      ],
      "basis": {
        "kind": "read",
        "sources": [
          "nexlayer.yaml"
        ]
      }
    }
  ]
}
